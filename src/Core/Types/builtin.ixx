using i16 = short;
using u16 = unsigned short;
using i32 = int;
using u32 = unsigned int;
using i64 = long long;
using u64 = unsigned long long;

using f32 = float;
using f64 = double;

using ansi = char;
using utf8 = char8_t;
using utf16 = char16_t;
using utf32 = char32_t;
using wchar = wchar_t;

using size = size_t;
